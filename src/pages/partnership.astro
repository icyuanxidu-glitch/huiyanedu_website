---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'B端合作',
  description: '慧研国际教育面向机构、学校和教育服务团队提供留学规划与学术支持合作。',
};

const partners = [
  '国际学校与升学指导团队',
  '教育咨询机构',
  '学术背景提升项目团队',
  '需要英国本地导师支持的合作方',
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Partnership</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">B端合作</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        慧研面向学校、机构与教育服务团队提供留学规划、材料支持、导师资源和申请流程协作。
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Who We Work With</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作对象</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-2">
        {partners.map((item) => (
          <div class="rounded-sm border border-slate-200 p-5 font-semibold text-[#0B1F3A]">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作原则</h2>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        我们重视透明分工、真实表达和长期服务质量。合作内容会根据学生阶段、机构需求和交付边界进行确认，不使用夸大宣传或未经核实的案例包装。
      </p>
    </div>
  </section>
</Layout>
