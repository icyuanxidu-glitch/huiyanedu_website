---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'B端合作',
  description: '慧研国际教育面向高报机构、国际本科项目、教育机构和一级代理提供英联邦升学规划与申请执行支持。',
};

const partners = ['高报机构', '国际本科项目', '教育机构', '一级代理'];
const support = ['学生转介', '路径规划', '申请执行', '后续服务支持'];
const process = [
  ['初步沟通', '确认合作对象、学生画像、服务边界和沟通方式。'],
  ['学生评估', '基于学生背景、目标和时间线形成初步判断。'],
  ['分工确认', '明确由合作方和慧研分别承担的沟通、材料和执行节点。'],
  ['过程反馈', '在申请推进中保持节点反馈，确保信息一致、口径清楚。'],
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Institutional Partnership</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">B端合作支持</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        面向高报机构、国际本科项目、教育机构和一级代理，提供专业、克制、可协作的英联邦升学服务支持。
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Partners</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作对象</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {partners.map((item) => <div class="rounded-sm border border-slate-200 p-5 font-semibold text-[#0B1F3A]">{item}</div>)}
        </div>
      </div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Scope</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作内容</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {support.map((item) => <div class="rounded-sm border border-slate-200 p-5 font-semibold text-[#0B1F3A]">{item}</div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Communication Flow</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">沟通流程</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-4">
        {
          process.map(([title, description], index) => (
            <article class="rounded-sm border border-slate-200 bg-white p-6">
              <div class="mb-5 text-2xl font-bold text-[#B8943F]">{String(index + 1).padStart(2, '0')}</div>
              <h3 class="text-xl font-bold text-[#0B1F3A]">{title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[#0B1F3A] py-20 text-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <Icon name="tabler:shield-check" class="h-10 w-10 text-[#D8B45F]" />
        <h2 class="mt-5 text-3xl font-bold tracking-normal md:text-4xl">合规与品牌口径</h2>
      </div>
      <p class="text-lg leading-8 text-slate-200">
        合作沟通中，慧研坚持清晰、审慎、可验证的表达方式。不夸大申请结果，不虚构合作资源，不用营销话术替代真实评估。
      </p>
    </div>
  </section>
</Layout>
