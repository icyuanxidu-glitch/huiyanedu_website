---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'B端合作 | 国际教育机构与英联邦申请支持',
  description: '慧研国际教育为高报机构、国际本科项目、教育咨询机构和合作顾问团队提供英联邦升学规划与申请支持。',
};

const partnerTypes = ['高报机构', '国际本科项目', '国际学校升学指导团队', '教育咨询机构', '一级代理或区域合作方', '有英国本地导师资源需求的合作方'];
const cooperation = ['学生初步评估', '英联邦升学路径设计', '院校与专业定位', '申请材料指导', '文书与研究计划支持', '申请执行与进度反馈', '面试辅导', '签证行前支持', '入学后的学术和职业服务衔接'];
const process = [
  { title: '初步沟通', text: '了解合作方业务场景、学生画像、服务需求和交付边界。' },
  { title: '学生需求匹配', text: '判断学生是否适合慧研参与的英联邦申请或后续服务支持。' },
  { title: '背景评估与路径建议', text: '基于真实材料输出路径建议、风险点和执行优先级。' },
  { title: '分工确认与申请执行', text: '明确合作方、学生和慧研之间的沟通机制、材料责任和时间节点。' },
  { title: '结果反馈与长期维护', text: '同步申请进度与关键反馈，并可衔接入学后的学术、职业和本地事务支持。' },
];
const principles = ['透明分工', '真实评估', '不夸大结果', '不包装虚假案例', '不制造不实材料', '保护学生信息', '尊重合作方品牌口径'];
const profiles = [
  '希望补足英联邦申请能力的高报团队',
  '有国际本科、专升本、预科项目资源的机构',
  '有学生资源但缺少英国本地后续服务的机构',
  '希望提升顾问专业交付质量的小型教育团队',
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Partnership</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">B端合作</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        慧研为高报机构、国际本科项目、教育机构和合作顾问团队提供英联邦升学路径规划、申请执行和学生后续服务支持。
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-3">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Partners</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作对象</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-2">
        {partnerTypes.map((item) => <div class="rounded-sm border border-slate-200 p-5 font-semibold text-[#0B1F3A]">{item}</div>)}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作内容</h2>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {cooperation.map((item) => <div class="rounded-sm border border-slate-200 bg-white p-4 font-semibold text-[#0B1F3A]">{item}</div>)}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Workflow</p>
      <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">合作流程</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-5">
        {process.map((item, index) => (
          <article class="rounded-sm border border-slate-200 p-5">
            <div class="text-sm font-semibold text-[#B8943F]">0{index + 1}</div>
            <h3 class="mt-3 text-xl font-bold text-[#0B1F3A]">{item.title}</h3>
            <p class="mt-4 text-sm leading-6 text-slate-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#071A31] py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#D8B45F]">Principles</p>
      <h2 class="mt-3 text-3xl font-bold tracking-normal md:text-4xl">合作原则</h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-7">
        {principles.map((item) => <div class="rounded-sm border border-white/15 bg-white/5 p-4 text-sm font-semibold">{item}</div>)}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">适合我们合作的机构</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {profiles.map((item) => <div class="rounded-sm border border-slate-200 p-5 font-semibold leading-7 text-[#0B1F3A]">{item}</div>)}
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
      <h2 class="text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">需要英国本地申请与后续支持？</h2>
      <a class="inline-flex rounded-sm bg-[#D8B45F] px-6 py-3 font-semibold text-[#071A31] transition hover:bg-[#E5C878]" href="/contact">
        联系合作负责人
      </a>
    </div>
  </section>
</Layout>
