---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于慧研',
  description: '了解慧研国际教育的团队定位、服务方式与申请陪伴理念。',
};

const values = [
  { title: '本地视角', text: '团队长期理解英国高校教学、研究和申请沟通语境，帮助学生更准确地表达学术潜力。' },
  { title: '非流水线', text: '每位学生的背景、节奏和目标不同，申请方案需要基于真实材料和阶段性反馈逐步调整。' },
  { title: '全周期陪伴', text: '从早期规划、申请材料到面试准备和行前衔接，关注的不只是提交申请本身。' },
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">About Huiyan</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">关于慧研国际教育</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        慧研国际教育由英国本地硕博导师团队参与服务，专注为计划申请海外本科、硕士与博士项目的学生提供规划、材料、面试和落地陪伴。
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-3">
      {values.map((item) => (
        <article class="rounded-sm border border-slate-200 p-6">
          <h2 class="text-2xl font-bold text-[#0B1F3A]">{item.title}</h2>
          <p class="mt-4 leading-7 text-slate-600">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Our Approach</p>
      <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">先理解人，再设计申请路径</h2>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        我们重视学生已有经历背后的动机、能力和成长线索。申请方案不会围绕单一排名或简单模板展开，而是结合目标专业要求、学生当下阶段和可投入时间，形成更稳健的推进方式。
      </p>
    </div>
  </section>
</Layout>
