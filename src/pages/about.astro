---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '关于慧研',
  description: '了解慧研国际教育的机构定位、服务原则与英国本地硕博导师团队。',
};

const principles = [
  ['真实评估', '基于学生当前背景、目标、预算和时间线做判断，不用单一排名替代路径规划。'],
  ['路径论证', '从课程结构、录取逻辑、城市选择和长期发展角度复核申请方案。'],
  ['导师参与', '由熟悉英国高校学术环境的硕博导师参与关键节点支持。'],
  ['长期陪伴', '服务不止于递交申请，也覆盖签证行前、入学适应、学术与职业发展。'],
];

const audiences = ['学生', '家长', 'B端教育机构', '国际升学项目'];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">About Huiyan</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">关于慧研国际教育</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        慧研国际教育是一家英国注册的国际教育咨询机构，专注英联邦国家本科、硕士、博士申请规划。
      </p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Positioning</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">英国本地硕博导师团队</h2>
      </div>
      <div class="space-y-5 text-lg leading-8 text-slate-600">
        <p>
          我们以英国本地教育生态和硕博导师团队为基础，帮助学生和家庭理解不同升学路径的适配度，而不是把申请简化为模板化材料流程。
        </p>
        <p>
          慧研强调非流水线留学和全周期陪伴，从选校定位、申请文书、签证行前，到入学后的学术支持与职业发展，持续关注学生的真实成长路径。
        </p>
        <p class="border-l-2 border-[#D8B45F] bg-slate-50 p-5 text-base leading-7 text-[#0B1F3A]">
          我们不做保证录取承诺，更重视真实评估、路径规划和执行过程中的透明沟通。
        </p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">How We Work</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">我们的服务原则</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          principles.map(([title, description]) => (
            <article class="rounded-sm border border-slate-200 bg-white p-6">
              <Icon name="tabler:checks" class="mb-5 h-8 w-8 text-[#B8943F]" />
              <h3 class="text-xl font-bold text-[#0B1F3A]">{title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Who We Serve</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">服务对象</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          audiences.map((item) => (
            <div class="rounded-sm border border-slate-200 bg-white p-5 text-lg font-semibold text-[#0B1F3A]">
              {item}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
