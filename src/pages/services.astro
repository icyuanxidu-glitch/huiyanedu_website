---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '服务体系',
  description: '慧研国际教育面向学生和家长提供本科、硕士、博士申请规划及全周期升学支持。',
};

const services = [
  {
    title: '本科申请规划',
    audience: '高中、国际课程、预科转入或计划申请英联邦本科的学生。',
    focus: '课程匹配、院校梯度、专业方向、时间线和材料策略。',
    deliverable: '申请路径建议、院校专业清单、材料准备清单和执行节奏表。',
  },
  {
    title: '硕士申请规划',
    audience: '本科在读、已毕业或计划转换专业方向的申请者。',
    focus: '背景梳理、专业适配、文书叙事、申请批次与替代方案。',
    deliverable: '选校定位、申请材料框架、文书支持和递交流程管理。',
  },
  {
    title: '博士申请规划',
    audience: '计划申请研究型硕士、MPhil 或 PhD 的学生。',
    focus: '研究方向、导师匹配思路、Research Proposal 和沟通材料。',
    deliverable: '研究主题梳理、导师沟通建议、申请材料与时间线支持。',
  },
  {
    title: 'Foundation / International Year One / Pre-Master',
    audience: '需要桥梁课程衔接本科或硕士阶段学习的学生。',
    focus: '升读要求、课程衔接、语言要求、预算与后续学位路径。',
    deliverable: '路径对比、课程建议、申请材料清单和升读风险提示。',
  },
  {
    title: 'Top-up 专升本',
    audience: '希望通过英国本科最后一年完成学历衔接的专科或相关背景学生。',
    focus: '已有学历评估、专业衔接、入学要求和后续硕士选择。',
    deliverable: 'Top-up 路径建议、专业匹配表、申请材料和后续规划。',
  },
  {
    title: '学术辅导',
    audience: '希望提升课程适应、论文写作和学术表达能力的在读学生。',
    focus: '学习方法、论文结构、阅读策略、学术规范和反馈迭代。',
    deliverable: '阶段性学习支持、作业思路辅导和学术能力提升建议。',
  },
  {
    title: '职业规划',
    audience: '希望把专业选择、实习探索和长期职业目标结合起来的学生。',
    focus: '行业方向、技能差距、简历表达、实习路径和升学后的职业准备。',
    deliverable: '职业方向梳理、能力提升建议和阶段性行动计划。',
  },
  {
    title: '海外落地支持',
    audience: '即将入学或已经抵达英国及其他英联邦国家的学生。',
    focus: '签证行前、住宿准备、入学适应、学习节奏和生活安排。',
    deliverable: '行前清单、入学准备建议和落地后沟通支持。',
  },
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Services</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">全周期留学规划服务</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        面向学生和家长，提供从路径评估、申请执行到入学后支持的清晰服务体系。
      </p>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-5 md:grid-cols-2">
        {
          services.map((service) => (
            <article class="rounded-sm border border-slate-200 bg-white p-6">
              <Icon name="tabler:briefcase" class="mb-5 h-8 w-8 text-[#B8943F]" />
              <h2 class="text-2xl font-bold text-[#0B1F3A]">{service.title}</h2>
              <div class="mt-5 grid gap-4 text-sm leading-7 text-slate-600">
                <p><span class="font-semibold text-[#0B1F3A]">适合人群：</span>{service.audience}</p>
                <p><span class="font-semibold text-[#0B1F3A]">服务重点：</span>{service.focus}</p>
                <p><span class="font-semibold text-[#0B1F3A]">交付内容：</span>{service.deliverable}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Service Boundary</p>
      <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">真实评估，而不是结果承诺</h2>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        慧研重视申请判断、材料质量和执行节奏。我们会清楚说明机会、限制和替代路径，不以夸大承诺替代专业规划。
      </p>
    </div>
  </section>
</Layout>
