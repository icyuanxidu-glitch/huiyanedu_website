---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '服务体系',
  description: '慧研国际教育提供申请规划、文书辅导、面试准备、博士套磁与落地陪伴等服务。',
};

const items = [
  { title: '前期定位与规划', text: '梳理背景、目标专业、院校层级、时间线和风险点，形成阶段性申请策略。' },
  { title: '文书与材料辅导', text: '围绕个人陈述、简历、推荐信素材和作品集逻辑，帮助学生建立清晰表达。' },
  { title: '面试与沟通准备', text: '针对面试、导师沟通或项目说明场景，训练表达结构、案例选择和答题节奏。' },
  { title: '博士申请支持', text: '协助研究方向梳理、导师匹配思路、研究计划结构和邮件沟通准备。' },
  { title: '行前与落地陪伴', text: '提供签证、住宿、行前清单和初到英国适应阶段的信息支持。' },
  { title: '阶段复盘', text: '根据申请进度、材料反馈和学生状态进行复盘，及时调整后续推进重点。' },
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Service System</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">服务体系</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        慧研以申请目标和学生背景为起点，把选校、材料、面试、沟通和落地准备拆解成可执行的步骤。
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-5 px-4 sm:px-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <article class="rounded-sm border border-slate-200 p-6">
          <h2 class="text-xl font-bold text-[#0B1F3A]">{item.title}</h2>
          <p class="mt-4 leading-7 text-slate-600">{item.text}</p>
        </article>
      ))}
    </div>
  </section>
</Layout>
