---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = {
  title: '页面未找到',
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">404</p>
      <h1 class="mt-4 text-4xl font-bold tracking-normal md:text-5xl">页面未找到</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-200">
        你访问的页面可能已经移动或不存在。可以返回首页，继续了解慧研国际教育的服务与升学路径。
      </p>
      <a class="mt-8 rounded-sm bg-[#D8B45F] px-6 py-3 font-semibold text-[#071A31] transition hover:bg-[#E5C878]" href={getHomePermalink()}>
        返回首页
      </a>
    </div>
  </section>
</Layout>
