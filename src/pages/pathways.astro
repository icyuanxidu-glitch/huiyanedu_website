---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '升学路径',
  description: '慧研国际教育支持本科、硕士、博士及转专业申请路径规划。',
};

const pathways = [
  { title: '本科申请', text: '适合准备英国及海外本科申请的学生，重点关注课程选择、活动积累、文书主题和时间安排。' },
  { title: '硕士申请', text: '适合本科在读或毕业学生，重点关注专业匹配、背景提升、材料表达和多轮申请节奏。' },
  { title: '博士申请', text: '适合有研究兴趣和学术积累的学生，重点关注研究方向、导师沟通、研究计划和资金信息。' },
  { title: '转专业与跨学科申请', text: '适合希望调整方向的学生，重点梳理已有经历与目标专业之间的逻辑桥梁。' },
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Study Pathways</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">升学路径</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        不同阶段的申请重点不同。慧研帮助学生先确认方向，再建立材料、经历和时间线之间的配合。
      </p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-5 px-4 sm:px-6 md:grid-cols-2">
      {pathways.map((item) => (
        <article class="rounded-sm border border-slate-200 p-6">
          <h2 class="text-2xl font-bold text-[#0B1F3A]">{item.title}</h2>
          <p class="mt-4 leading-7 text-slate-600">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">路径评估看什么</h2>
      <p class="mt-5 text-lg leading-8 text-slate-600">
        初步评估通常会结合学术成绩、语言情况、专业背景、实践经历、目标地区、预算、申请时间和个人偏好。评估结果用于明确下一步准备重点，不构成录取承诺。
      </p>
    </div>
  </section>
</Layout>
