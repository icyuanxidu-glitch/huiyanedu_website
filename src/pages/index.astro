---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '慧研国际教育',
  ignoreTitleTemplate: true,
  description: '英国本地硕博导师团队，为学生提供非流水线的留学申请规划、文书辅导、面试准备与落地陪伴。',
};

const strengths = [
  '英国本地硕博导师团队参与规划与反馈',
  '围绕学生背景、目标和时间线定制申请节奏',
  '从选校定位到入学前准备提供全周期陪伴',
];

const services = [
  { title: '申请定位', text: '梳理学术背景、经历亮点、目标专业与时间线，形成清晰可执行的申请路径。' },
  { title: '材料打磨', text: '围绕个人陈述、简历、推荐信素材和作品集逻辑，协助学生表达真实优势。' },
  { title: '面试准备', text: '结合目标项目常见考察方向，进行表达结构、案例组织和临场沟通训练。' },
  { title: '落地支持', text: '在签证、住宿、行前准备和初到英国适应阶段提供实用陪伴。' },
];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Huiyan Education</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-6xl">
        英国本地硕博导师团队，陪你走完整个留学申请周期
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        慧研国际教育专注本科、硕士、博士申请规划，以非流水线方式理解每位学生的背景与目标，帮助申请者建立稳健、真实、可持续的升学路径。
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="rounded-sm bg-[#D8B45F] px-6 py-3 font-semibold text-[#071A31] transition hover:bg-[#E5C878]" href="/contact">
          免费评估
        </a>
        <a class="rounded-sm border border-white/30 px-6 py-3 font-semibold text-white transition hover:bg-white/10" href="/services">
          查看服务体系
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-3">
      {strengths.map((item) => (
        <article class="rounded-sm border border-slate-200 p-6">
          <div class="h-1 w-12 bg-[#D8B45F]"></div>
          <p class="mt-5 text-lg font-semibold leading-8 text-[#0B1F3A]">{item}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">What We Do</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">把复杂申请拆成清晰步骤</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          我们不会用统一模板替代个人判断，而是围绕学生的专业方向、经历积累、申请阶段和目标院校要求，逐步推进每一个关键环节。
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((item) => (
          <article class="rounded-sm border border-slate-200 bg-white p-6">
            <h3 class="text-xl font-bold text-[#0B1F3A]">{item.title}</h3>
            <p class="mt-4 leading-7 text-slate-600">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Selected Outcomes</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">2023–2025 慧研录取精选</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          以下内容为慧研过往服务成果展示，具体申请结果因学生背景、申请阶段、目标院校及当年录取政策而异。
        </p>
      </div>
      <div class="mt-10 overflow-hidden rounded-sm border border-slate-200 bg-slate-50">
        <img
          src="/images/huiyan-offer-wall.png"
          alt="2023–2025 慧研录取精选"
          class="w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="bg-[#071A31] py-16 text-white sm:py-20">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 sm:px-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#D8B45F]">Start With Clarity</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal md:text-4xl">先做一次真实的路径评估</h2>
      </div>
      <a class="inline-flex rounded-sm bg-[#D8B45F] px-6 py-3 font-semibold text-[#071A31] transition hover:bg-[#E5C878]" href="/contact">
        联系我们
      </a>
    </div>
  </section>
</Layout>
