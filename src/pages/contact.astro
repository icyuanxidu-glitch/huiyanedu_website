---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '联系我们',
  description: '联系慧研国际教育，获取一份适合你的留学路径评估。',
};

const audiences = ['学生', '家长', '合作机构'];
const preparation = ['申请阶段', '目标国家', '专业方向', '当前学历', '成绩', '语言', '预算', '时间线'];
---

<Layout metadata={metadata}>
  <section class="bg-[#071A31] text-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#D8B45F]">Contact Huiyan</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight tracking-normal md:text-5xl">
        获取一份适合你的留学路径评估
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-200">
        先从清晰沟通开始。你可以把背景、目标和时间线发给我们，我们会协助判断下一步更适合如何推进。
      </p>
      <div class="mt-9">
        <a
          class="inline-flex items-center justify-center rounded-sm bg-[#D8B45F] px-6 py-3 text-base font-semibold text-[#071A31] transition hover:bg-[#E5C878]"
          href="mailto:huiyanliuxue.info@gmail.com"
        >
          预约免费咨询
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-3">
      <article class="rounded-sm border border-slate-200 p-6 lg:col-span-1">
        <Icon name="tabler:mail" class="mb-5 h-9 w-9 text-[#B8943F]" />
        <h2 class="text-2xl font-bold text-[#0B1F3A]">联系方式</h2>
        <p class="mt-4 leading-7 text-slate-600">Email: huiyanliuxue.info@gmail.com</p>
      </article>
      <article class="rounded-sm border border-slate-200 p-6 lg:col-span-2">
        <h2 class="text-2xl font-bold text-[#0B1F3A]">咨询适合人群</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {audiences.map((item) => <div class="bg-slate-50 p-4 font-semibold text-[#0B1F3A]">{item}</div>)}
        </div>
      </article>
    </div>
  </section>

  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[#B8943F]">Before Consultation</p>
        <h2 class="mt-3 text-3xl font-bold tracking-normal text-[#0B1F3A] md:text-4xl">咨询前建议准备的信息</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          信息越清楚，初步路径评估越有效。没有完整材料也没关系，可以先从已有信息开始。
        </p>
      </div>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {preparation.map((item) => <div class="rounded-sm border border-slate-200 bg-white p-5 font-semibold text-[#0B1F3A]">{item}</div>)}
      </div>
    </div>
  </section>
</Layout>
